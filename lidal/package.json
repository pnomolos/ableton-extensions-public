{
  "name": "lidal",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "build:prod": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "deploy": "node esbuild.js && node scripts/deploy.js",
    "pack": "node esbuild.js --production && node scripts/pack.js",
    "test": "node test/offline.js && vitest run",
    "test:spec": "vitest run",
    "test:e2e": "node test/e2e/verify-ux.mjs",
    "test:offline": "node test/offline.js",
    "typecheck": "tsc --noEmit",
    "build:headless": "node esbuild.js --headless",
    "start:headless": "node test/headless/runner.mjs"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../extensions-sdk",
    "abletonlink": "^0.2.0-beta.0",
    "easymidi": "^3.1.0"
  },
  "arclightNativeDeps": [
    "easymidi",
    "abletonlink"
  ],
  "arclightExtraDistFiles": [
    "editor-client.js"
  ],
  "arclightPackTargets": [
    {
      "platform": "darwin",
      "arch": "arm64"
    },
    {
      "platform": "darwin",
      "arch": "x64"
    }
  ],
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "~1.60.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
