{
  "name": "arclight-extensions",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:prod": "pnpm -r --if-present run build:prod",
    "dev:harmonic-lens": "pnpm --filter harmonic-lens dev",
    "dev:beat-detective": "pnpm --filter beat-detective dev",
    "dev:groove-transplant": "pnpm --filter groove-transplant dev",
    "dev:conway-clips": "pnpm --filter conway-clips dev",
    "test": "pnpm -r --if-present run test",
    "build:all": "pnpm --filter @arclight/core run build && pnpm -r --if-present run build",
    "deploy:all": "pnpm -r --if-present run deploy"
  }
}
